# Local configuration for the Academy Student Progress Tracker.
#
# Copy this file to ".env":   cp .env.example .env
# Every value is optional. A line that stays commented out (#) uses the
# default from backend/config/settings.py. Remove the "#" to change a value.
# No value here is secret.
#
# Business rules (score range, statuses, text length) are NOT set here;
# they are edited in backend/config/business_rules.py.

# Name shown on the interactive API docs page (/docs).
# ACADEMY_APP_TITLE=Academy Students

# Address the server listens on. 127.0.0.1 = this computer only.
# Use 0.0.0.0 to allow other devices on your network.
# ACADEMY_HOST=127.0.0.1

# Port the server listens on. Allowed: 1-65535.
# Change it if 8000 is already used by another program.
# ACADEMY_PORT=8000

# Restart the server automatically when code changes.
# Allowed: true, false. Use false outside development.
# ACADEMY_RELOAD=true

# SQLite database file. Created automatically on first start.
# A relative path is relative to the folder you start the server from.
# ACADEMY_DATABASE_PATH=students.db

# Number of decimals in the average quiz score. Allowed: 0 or more.
# ACADEMY_AVERAGE_DECIMALS=2
